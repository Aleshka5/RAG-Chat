# Copy to .env. Secrets stay empty here. Do not commit .env.
# Names and defaults are docs/configuration.md. EMBEDDING_BATCH_SIZE is 16.

# Common
MONGODB_URI=mongodb://mongo:27017/rag
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=documents
S3_REGION=us-east-1
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
RABBITMQ_URL=amqp://rabbit:5672/
RABBITMQ_EXCHANGE=doc_events
RABBITMQ_DLX=doc_events_dlq
EMBEDDING_URL=http://embedding:8091
OCR_URL=http://ocr:8090
LOG_LEVEL=info

# File Collector
FILE_COLLECTOR_PORT=8081
MAX_UPLOAD_BYTES=524288000

# Processor
PROCESSOR_CONCURRENCY=1
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=51
MAX_PROCESS_ATTEMPTS=8
MIN_EXTRACTED_CHARS=50
OCR_RENDER_DPI=300
OCR_TIMEOUT=120
OCR_MAX_ATTEMPTS=3
# Processor and Embedding default 30. Chat's own default is 10 when this is unset in that process.
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIM=768
EMBEDDING_MAX_TOKENS=1024
QDRANT_UPSERT_BATCH=64
STALE_PROCESSING_SECONDS=900
SWEEP_INTERVAL_SECONDS=60
UPLOAD_REQUEUE_AFTER_SECONDS=120

# Deletion Worker (STALE_PROCESSING_SECONDS and SWEEP_INTERVAL_SECONDS match Processor)
DELETION_CONCURRENCY=1
DELETE_REQUEUE_AFTER_SECONDS=120

# Chat
CHAT_PORT=8082
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
RAG_TOP_K=5
RAG_MIN_SCORE=0
RAG_CONTEXT_MESSAGES=10

# OCR
OCR_PORT=8090
OCR_MODEL=surya-ocr-2
OCR_LLAMA_URL=http://127.0.0.1:8092

# Embedding
EMBEDDING_PORT=8091
EMBEDDING_MODEL=google/embeddinggemma-2
EMBEDDING_GGUF=embeddinggemma-2-Q8_0.gguf
EMBEDDING_LLAMA_URL=http://127.0.0.1:8092
EMBEDDING_CONTEXT=2048

# rag-edge
RAG_EDGE_PORT=8080
FILE_COLLECTOR_URL=http://file-collector:8081
CHAT_URL=http://chat:8082
FRONTEND_URL=http://frontend:3000
